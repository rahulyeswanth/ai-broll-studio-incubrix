# Copy to backend/.env and fill in. NEVER commit the real file. Values below are placeholders only.

# --- application ---
APP_NAME=AI B-roll Studio
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- storage (relative paths are resolved against the backend/ folder, not the working directory) ---
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage_data
STORAGE_ROOT=./storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=broll-assets
MINIO_SECURE=false
REDIS_URL=redis://localhost:6379/0

# --- providers ---
# TTS_PROVIDER: edge (real narration, needs internet + `pip install edge-tts`) | mock (placeholder tones, NOT narration)
TTS_PROVIDER=edge
# TRANSCRIPTION_PROVIDER: whisper (real, local, `pip install faster-whisper`) | mock (canned text, NOT your audio)
TRANSCRIPTION_PROVIDER=whisper
# FOOTAGE_PROVIDER: pixabay | pexels   (mock cannot be rendered)
FOOTAGE_PROVIDER=pixabay
# Mock TTS/transcription are refused unless this is true; when true, outputs are labelled as placeholders.
ALLOW_MOCK_PROVIDERS=false

PIXABAY_API_KEY=your-pixabay-key-here
PEXELS_API_KEY=

# --- narration / transcription ---
TTS_DEFAULT_VOICE=en-US-AriaNeural
DEFAULT_LANGUAGE=en
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- limits ---
MAX_AUDIO_FILE_SIZE_MB=50
MAX_AUDIO_SECONDS=900
MAX_SCRIPT_CHAR_LENGTH=10000
MAX_VIDEO_DOWNLOAD_MB=100
MIN_SCENE_DURATION_SECONDS=2.0
MAX_SCENE_DURATION_SECONDS=12.0

# --- matching ---
# Minimum relevance (0-1) for a clip to count as a match. Raise for stricter matching.
MATCH_THRESHOLD=0.45
# metadata (title/tag text only - transparent fallback) | clip (OpenCLIP frame analysis; see requirements-optional.txt)
VISUAL_VERIFIER=metadata
# review (default): a clip below the threshold but above MATCH_REVIEW_FLOOR is used and flagged "needs review";
#   below the floor the scene is UNMATCHED and gets a plain placeholder (the rest of the video is still produced).
# best_available: legacy - always use the best clip however poor (disclosed). fail: any unmatched scene fails the job.
MATCH_FALLBACK_POLICY=review
MATCH_REVIEW_FLOOR=0.30
# A passing clip is labelled "High" only if its score >= this AND title/tags (or frames) evidence the action/object.
MATCH_HIGH_CONFIDENCE=0.70
# Extra passing candidates tried when the chosen clip cannot be downloaded / is a near-duplicate of another scene's clip.
MAX_DOWNLOAD_ALTERNATES=4
# dHash distance (0-64) at or below which two clips are treated as near-duplicates.
DUPLICATE_HASH_DISTANCE=6
# Second footage source (auto-detected when PEXELS_API_KEY is set) and the rule threshold.
FOOTAGE_FALLBACK_PROVIDERS=
FOOTAGE_MIN_PRIMARY_RESULTS=3
NORMALIZE_COLOR=true
READINESS_REQUIRE_REDIS=false
