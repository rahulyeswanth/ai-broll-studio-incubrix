# Copy to .env. Never commit real values.
PIXABAY_API_KEY=
PEXELS_API_KEY=
COVERR_API_KEY=
# API auth (comma-separated keys, sent as X-API-Key). Empty = open API (local dev only).
API_KEYS=
CORS_ORIGINS=http://localhost:8501
RATE_LIMIT_PER_MINUTE=60
JOB_MAX_ATTEMPTS=2
TRANSCRIPTION_TIMEOUT_SECONDS=300
# HMAC secret for signed job callbacks
CALLBACK_SECRET=
# Tests only: allow callback/audio URLs on private addresses. Keep false in production.
ALLOW_PRIVATE_URLS=false
STORAGE_TYPE=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=broll-assets
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000
# Caption size in px at 1080-class output (scaled for other sizes). Unset = automatic (~32 px). 16 is roughly "12 pt".
CAPTION_FONT_PX=
# Optional: exact font file and family name for captions. Default: Times New Roman, else Liberation Serif, else DejaVu Serif.
CAPTION_FONT_FILE=
CAPTION_FONT_NAME=
# Second footage source: auto-detected when PEXELS_API_KEY is set. Comma list in priority order after the primary, or "none".
FOOTAGE_FALLBACK_PROVIDERS=
# Query the next provider when the previous returned fewer than this many assets.
FOOTAGE_MIN_PRIMARY_RESULTS=3
# Even out brightness/saturation between clips of one video (ffmpeg eq).
NORMALIZE_COLOR=true
# Scenes shorter than this are merged into a neighbour.
MIN_SCENE_DURATION_SECONDS=2.0
# /ready fails when Redis is down only if true.
READINESS_REQUIRE_REDIS=false
